# =====================================================================
# ocean (AIOcean) workflow — sync, run, fetch results
# Run these from the local project root: ~/research/dacon
# Remote:  ocean@163.180.185.68:32434  (non-default SSH port -> rsync needs -e "ssh -p ...")
# NOTE: set the remote path below to your ocean instance's project dir (placeholder: ~/dacon).
# =====================================================================

# --- 1. sync local -> ocean ---
rsync -avz --delete --exclude-from='.rsyncignore' -e "ssh -p 32434" ./ ocean@163.180.185.68:~/dacon/

# --- 2. submit the job on ocean ---
ssh -p 32434 ocean@163.180.185.68 'cd ~/dacon && sbatch sbatch/template.sbatch'

# --- 3. fetch results ocean -> local ---
rsync -avz -e "ssh -p 32434" ocean@163.180.185.68:~/dacon/sbatch/logs/ ./sbatch/logs/
rsync -avz --exclude='checkpoint-*/optimizer.pt' -e "ssh -p 32434" ocean@163.180.185.68:~/dacon/output/ ./output/
